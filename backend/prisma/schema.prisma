generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  avatar       String?
  status       String   @default("OFFLINE") // ONLINE / OFFLINE / BUSY

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaces   Workspace[] @relation("WorkspaceOwner")
  memberships  WorkspaceMember[]
  knowledgeBases KnowledgeBase[] @relation("KnowledgeBaseOwner")
  skills       Skill[] @relation("SkillOwner")
  mcpServers   McpServer[] @relation("McpServerOwner")
  agents       Agent[]

  // 好友关系（双向查询用 OR：userId = me 或 friendId = me）
  friendshipsInitiated Friendship[] @relation("FriendshipInitiator")
  friendshipsReceived  Friendship[] @relation("FriendshipReceiver")
}

model Workspace {
  id              String   @id @default(uuid())
  name            String

  ownerId         String
  owner           User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members         WorkspaceMember[]
  workflows       Workflow[]
  knowledgeBases  WorkspaceKnowledgeBase[]
  agents          Agent[]
}

model WorkspaceMember {
  id          String @id @default(uuid())

  workspaceId String
  userId      String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([workspaceId, userId])
}

model Workflow {
  id              String           @id @default(uuid())
  workspaceId     String
  name            String
  description     String?
  status          String           @default("DRAFT")   // DRAFT / PUBLISHED / ARCHIVED
  currentVersionId String?                              // 草稿版本（最新编辑版本）
  publishedVersionId String?                           // 已发布版本（Agent 调用的稳定版本）

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions        WorkflowVersion[] @relation("WorkflowVersions")
  currentVersion  WorkflowVersion? @relation("WorkflowCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  publishedVersion WorkflowVersion? @relation("WorkflowPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  runs            WorkflowRun[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([workspaceId])
  @@unique([currentVersionId])
  @@unique([publishedVersionId])
}

model WorkflowVersion {
  id             String    @id @default(uuid())
  workflowId     String
  version        Int
  definition     Json
  createdAt      DateTime  @default(now())

  workflow       Workflow  @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  currentWorkflow Workflow? @relation("WorkflowCurrentVersion")
  publishedWorkflow Workflow? @relation("WorkflowPublishedVersion")

  @@unique([workflowId, version])
  @@index([workflowId])
}

// ---------------------------------------------------------------------------
// WorkflowRun（工作流运行记录 —— BullMQ 异步执行结果持久化）
// ---------------------------------------------------------------------------

model WorkflowRun {
  id            String   @id @default(uuid())
  workflowId    String

  input         Json?
  output        Json?

  status        String   @default("QUEUED")   // QUEUED / RUNNING / COMPLETED / FAILED
  errorMessage  String?

  startedAt     DateTime?
  completedAt   DateTime?

  createdAt     DateTime @default(now())

  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeRuns      WorkflowNodeRun[]

  @@index([workflowId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// WorkflowNodeRun（节点级执行记录 —— 每个 Node 的执行明细）
// ---------------------------------------------------------------------------

model WorkflowNodeRun {
  id            String   @id @default(uuid())
  runId         String
  nodeId        String
  nodeType      String
  label         String?

  status        String   @default("PENDING")   // PENDING / RUNNING / SUCCESS / FAILED
  input         Json?
  output        Json?
  branch        String?
  metadata      Json?
  errorMessage  String?

  startedAt     DateTime?
  endedAt       DateTime?
  durationMs    Int?

  createdAt     DateTime @default(now())

  run           WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([runId, nodeId])
}


// ---------------------------------------------------------------------------
// Knowledge Base（知识库 —— 独立资源，可关联到多个 Workspace）
// ---------------------------------------------------------------------------

model KnowledgeBase {
  id                 String   @id @default(uuid())
  ownerId            String

  name               String
  description        String?

  embeddingModel     String
  embeddingDimension Int

  documentCount      Int      @default(0)
  chunkCount         Int      @default(0)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner              User     @relation("KnowledgeBaseOwner", fields: [ownerId], references: [id])
  documents          Document[]
  workspaces         WorkspaceKnowledgeBase[]

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// WorkspaceKnowledgeBase（中间表：Workspace ↔ KnowledgeBase 多对多）
// ---------------------------------------------------------------------------

model WorkspaceKnowledgeBase {
  id               String @id @default(uuid())

  workspaceId       String
  knowledgeBaseId   String

  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeBase    KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())

  @@unique([workspaceId, knowledgeBaseId])
  @@index([knowledgeBaseId])
}

// ---------------------------------------------------------------------------
// Document（文档，知识库中的文件）
// ---------------------------------------------------------------------------

model Document {
  id             String   @id @default(uuid())
  knowledgeBaseId String

  fileName       String
  fileType       String
  fileSize       Int
  storagePath    String
  mimeType       String?
  status         String   @default("UPLOADED")   // UPLOADED / PROCESSING / COMPLETED / FAILED
  errorMessage   String?
  pageCount      Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  knowledgeBase  KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]

  @@index([knowledgeBaseId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// DocumentChunk（文档分块，对应 pgvector 存储）
// ---------------------------------------------------------------------------

model DocumentChunk {
  id          String   @id @default(uuid())
  documentId  String

  content     String
  chunkIndex  Int
  tokenCount  Int?
  // ⚠️ embedding 由 pgvector 扩展单独手写 migration 添加（Prisma Unsupported 类型无法自动生成）
  //   embedding vector(768)    ← 手写 migration 加
  metadata    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chunkIndex])
}

// ---------------------------------------------------------------------------
// Agent —— 可配置的 AI Agent（绑定 Workflow / Knowledge / LLM Prompt）
// ---------------------------------------------------------------------------

model Agent {
  id                  String   @id @default(uuid())
  workspaceId         String?          // 可空：系统 Agent 不属于任何 Workspace
  createdBy           String?          // 可空：系统 Agent 无创建者

  name                String
  description         String?
  avatar              String?          // 头像或图标标识
  type                String   @default("GENERAL")  // GENERAL / KNOWLEDGE / WORKFLOW / TOOL / CUSTOM
  isDefault           Boolean  @default(false)      // 是否为用户的默认 Agent
  isSystem            Boolean  @default(false)      // 系统预设 Agent（不可删除）
  status              String   @default("PUBLISHED") // DRAFT / PUBLISHED / DISABLED

  // LLM 配置
  model               String   @default("qwen2.5:7b")
  systemPrompt        String?  // System Prompt，支持 {{变量}}

  // 绑定的工具资源（JSON 存储 ID 数组，避免多对多中间表爆炸）
  workflowIds         String[]
  knowledgeBaseIds    String[]
  skillIds            String[]
  mcpServerIds        String[]

  // 运行参数
  maxToolIterations   Int      @default(10)   // ReAct 循环上限，防无限调用
  temperature         Float    @default(0.7)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace           Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  creator             User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  sessions            ChatSession[]

  @@index([workspaceId])
  @@index([createdBy])
  @@index([isSystem])
}

// ---------------------------------------------------------------------------
// ChatSession —— 每个 Agent 拥有独立的会话列表
// ---------------------------------------------------------------------------

model ChatSession {
  id          String      @id @default(uuid())
  userId      String
  agentId     String

  title       String      @default("新对话")

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@index([userId, agentId, updatedAt])
}

// ---------------------------------------------------------------------------
// ChatMessage —— 会话中的消息（用户 + Agent 回复 + 执行轨迹）
// ---------------------------------------------------------------------------

model ChatMessage {
  id          String      @id @default(uuid())
  sessionId   String

  role        String      // user / assistant / system / tool
  content     String

  /** Assistant 消息的 LLM 原始 tool_calls —— JSON 存储（用于多轮对话历史重建） */
  toolCalls   Json?
  /** Assistant 消息的执行轨迹（thinking / tool_call / tool_result）—— JSON 存储 */
  trail       Json?

  /** tool 消息关联的 tool_call_id */
  toolCallId  String?

  createdAt   DateTime    @default(now())

  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Friendship（好友关系 —— 单向存储，列表查询用 OR 双向匹配）
// ---------------------------------------------------------------------------

model Friendship {
  id        String   @id @default(uuid())

  userId    String   // 发起者
  friendId  String   // 接收者

  status    String   @default("PENDING") // PENDING / ACCEPTED / REJECTED / BLOCKED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("FriendshipInitiator", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendshipReceiver", fields: [friendId], references: [id], onDelete: Cascade)

  // 同一对用户只能有一条 Friendship 记录
  @@unique([userId, friendId])
  @@index([friendId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Skill —— 可复用的 Agent 能力定义（Prompt / Workflow / Tool 三种类型）
// ---------------------------------------------------------------------------

model Skill {
  id          String   @id @default(uuid())
  ownerId     String

  name        String
  description String?

  // Skill 类型：PROMPT（指令模板）/ WORKFLOW（调用工作流）/ TOOL（调用 MCP）
  type        String   @default("PROMPT")

  // System Instructions（Prompt 类型的核心 —— 告诉 Agent 如何完成某类任务）
  instructions String?

  // 输入参数 schema（JSON Schema 格式，LLM 可见的 function parameters）
  inputSchema  Json?

  // 输出格式（Markdown / JSON / Text）
  outputFormat String   @default("Markdown")

  // WORKFLOW 类型：绑定的 Workflow ID
  workflowId   String?

  // TOOL 类型：绑定的 McpServer ID + Tool Name
  mcpServerId  String?
  mcpToolName  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner        User     @relation("SkillOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// McpServer —— MCP (Model Context Protocol) 外部能力连接
// ---------------------------------------------------------------------------

model McpServer {
  id          String   @id @default(uuid())
  ownerId     String

  name        String
  description String?

  // 传输方式：SSE / STREAMABLE_HTTP
  transport   String   @default("STREAMABLE_HTTP")

  // MCP Server URL
  serverUrl   String

  // 认证方式：NONE / API_KEY / BEARER_TOKEN
  authType    String   @default("NONE")

  // 凭证（API Key / Bearer Token 值，生产环境应加密存储）
  credentials Json?

  // 连接状态：DISCONNECTED / CONNECTED / ERROR
  status      String   @default("DISCONNECTED")

  // 最近错误信息
  lastError   String?

  // 可用 Tools 列表（连接成功后缓存，JSON 数组）
  availableTools Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner        User     @relation("McpServerOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
}
