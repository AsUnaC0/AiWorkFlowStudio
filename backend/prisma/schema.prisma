generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  avatar       String?
  status       String   @default("OFFLINE") // ONLINE / OFFLINE / BUSY

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaces   Workspace[] @relation("WorkspaceOwner")
  memberships  WorkspaceMember[]
  knowledgeBases KnowledgeBase[] @relation("KnowledgeBaseOwner")
  skills       Skill[] @relation("SkillOwner")
  mcpServers   McpServer[] @relation("McpServerOwner")
  llmConfigs   LlmProviderConfig[] @relation("LlmConfigOwner")
  agents       Agent[]

  // 好友关系（双向查询用 OR：userId = me 或 friendId = me）
  friendshipsInitiated Friendship[] @relation("FriendshipInitiator")
  friendshipsReceived  Friendship[] @relation("FriendshipReceiver")
}

model Workspace {
  id              String   @id @default(uuid())
  name            String

  ownerId         String
  owner           User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members         WorkspaceMember[]
  workflows       Workflow[]
  knowledgeBases  WorkspaceKnowledgeBase[]
  agents          Agent[]
}

model WorkspaceMember {
  id          String @id @default(uuid())

  workspaceId String
  userId      String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([workspaceId, userId])
}

model Workflow {
  id              String           @id @default(uuid())
  workspaceId     String
  name            String
  description     String?
  status          String           @default("DRAFT")   // DRAFT / PUBLISHED / ARCHIVED
  currentVersionId String?                              // 草稿版本（最新编辑版本）
  publishedVersionId String?                           // 已发布版本（Agent 调用的稳定版本）

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions        WorkflowVersion[] @relation("WorkflowVersions")
  currentVersion  WorkflowVersion? @relation("WorkflowCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  publishedVersion WorkflowVersion? @relation("WorkflowPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  runs            WorkflowRun[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([workspaceId])
  @@unique([currentVersionId])
  @@unique([publishedVersionId])
}

model WorkflowVersion {
  id             String    @id @default(uuid())
  workflowId     String
  version        Int
  definition     Json
  createdAt      DateTime  @default(now())

  workflow       Workflow  @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  currentWorkflow Workflow? @relation("WorkflowCurrentVersion")
  publishedWorkflow Workflow? @relation("WorkflowPublishedVersion")

  @@unique([workflowId, version])
  @@index([workflowId])
}

// ---------------------------------------------------------------------------
// WorkflowRun（工作流运行记录 —— BullMQ 异步执行结果持久化）
// ---------------------------------------------------------------------------

model WorkflowRun {
  id            String   @id @default(uuid())
  workflowId    String

  input         Json?
  output        Json?

  status        String   @default("QUEUED")   // QUEUED / RUNNING / COMPLETED / FAILED
  errorMessage  String?
  errorCode     String?                       // 机器可读的错误码，如 AI_PROVIDER_TIMEOUT
  triggerType   String   @default("MANUAL")    // MANUAL / SCHEDULE / API / WEBHOOK
  durationMs    Int?                           // 总耗时（毫秒）

  startedAt     DateTime?
  completedAt   DateTime?

  createdAt     DateTime @default(now())

  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeRuns      WorkflowNodeRun[]
  modelCalls    ModelCallLog[]

  @@index([workflowId])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// WorkflowNodeRun（节点级执行记录 —— 每个 Node 的执行明细）
// ---------------------------------------------------------------------------

model WorkflowNodeRun {
  id            String   @id @default(uuid())
  runId         String
  nodeId        String
  nodeType      String
  label         String?

  status        String   @default("PENDING")   // PENDING / RUNNING / SUCCESS / FAILED
  input         Json?
  output        Json?
  branch        String?
  metadata      Json?
  errorMessage  String?
  errorCode     String?                        // 节点级错误码
  attemptsMade  Int      @default(0)           // 重试次数

  startedAt     DateTime?
  endedAt       DateTime?
  durationMs    Int?

  createdAt     DateTime @default(now())

  run           WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  modelCalls    ModelCallLog[]

  @@index([runId])
  @@index([runId, nodeId])
}

// ---------------------------------------------------------------------------
// ModelCallLog（模型调用记录 —— 统计 Token、延迟、错误与费用）
// ---------------------------------------------------------------------------

model ModelCallLog {
  id               String   @id @default(uuid())
  workspaceId      String                        // 用于权限隔离与统计归属
  workflowId       String?
  runId            String?
  nodeRunId        String?
  agentId          String?

  run              WorkflowRun?    @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeRun          WorkflowNodeRun? @relation(fields: [nodeRunId], references: [id], onDelete: Cascade)

  provider         String                        // ollama / openai-compatible / ...
  model            String                        // 实际模型名
  callType         String   @default("CHAT")     // CHAT / EMBEDDING / TOOL

  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  latencyMs        Int?
  status           String   @default("SUCCESS")   // SUCCESS / FAILED / TIMEOUT
  errorCode        String?
  errorMessage     String?
  estimatedCost    Float?                         // 配置价格后估算（单位：元/美元，按配置）

  createdAt        DateTime @default(now())

  @@index([workspaceId])
  @@index([runId])
  @@index([nodeRunId])
  @@index([model])
  @@index([status])
  @@index([createdAt])
}


// ---------------------------------------------------------------------------
// Knowledge Base（知识库 —— 独立资源，可关联到多个 Workspace）
// ---------------------------------------------------------------------------

model KnowledgeBase {
  id                 String   @id @default(uuid())
  ownerId            String

  name               String
  description        String?

  embeddingModel     String
  embeddingDimension Int
  /** 关联用户在「模型管理」中添加的 Embedding 模型（优先于 embeddingModel）；为空则回退到 Ollama 本地 embeddingModel */
  embeddingLlmModelId String?

  documentCount      Int      @default(0)
  chunkCount         Int      @default(0)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner              User     @relation("KnowledgeBaseOwner", fields: [ownerId], references: [id])
  documents          Document[]
  workspaces         WorkspaceKnowledgeBase[]
  embeddingVersions  KnowledgeBaseEmbeddingVersion[]

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// WorkspaceKnowledgeBase（中间表：Workspace ↔ KnowledgeBase 多对多）
// ---------------------------------------------------------------------------

model WorkspaceKnowledgeBase {
  id               String @id @default(uuid())

  workspaceId       String
  knowledgeBaseId   String

  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeBase    KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())

  @@unique([workspaceId, knowledgeBaseId])
  @@index([knowledgeBaseId])
}

// ---------------------------------------------------------------------------
// Document（文档，知识库中的文件）
// ---------------------------------------------------------------------------

model Document {
  id             String   @id @default(uuid())
  knowledgeBaseId String

  fileName       String
  fileType       String
  fileSize       Int
  storagePath    String
  mimeType       String?
  status         String   @default("UPLOADED")   // UPLOADED / PROCESSING / COMPLETED / FAILED
  errorMessage   String?
  pageCount      Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  knowledgeBase  KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]

  @@index([knowledgeBaseId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// DocumentChunk（文档分块，对应 pgvector 存储）
// ---------------------------------------------------------------------------

model DocumentChunk {
  id          String   @id @default(uuid())
  documentId  String

  content     String
  chunkIndex  Int
  tokenCount  Int?
  // pgvector 向量列 —— Prisma Unsupported 类型，由手写 migration 维护
  //
  // ⚠️ 重要：Prisma 7 无法在 schema 里声明向量索引（官方 pgvector 扩展要 Prisma 8），
  // 所以 dc_embedding_ivf（IVFFlat）只存在于手写 SQL 迁移中。
  // 结果是：**每次 `prisma migrate dev` 都会把这个索引当成"多余对象"并生成
  // `DROP INDEX "dc_embedding_ivf";`**。
  //
  // 正确做法：用 `npx prisma migrate dev --create-only` 生成迁移后，先打开 SQL
  // 检查，删掉这类 DROP 语句（必要时在末尾补 `CREATE INDEX IF NOT EXISTS`），
  // 再执行 `npx prisma migrate dev` 应用。否则向量索引会被静默删除。
  //
  // 另注：IVFFlat 索引在表数据很少时召回率很低（PostgreSQL 会提示 low recall），
  // 数据量上来后建议重建，或改用 HNSW。
  embedding   Unsupported("vector(768)")?
  metadata    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embeddings  DocumentChunkEmbedding[]

  @@index([documentId])
  @@index([chunkIndex])
}

// ---------------------------------------------------------------------------
// DocumentChunkEmbedding —— 某个文本块在某个向量版本下的「生成状态」
//
// 文本与向量解耦：切换模型 / 维度不再动 DocumentChunk（也不重复解析原文件），
// 只为新版本生成一份新向量，验证通过后再原子切换 isActive。
//
// ⚠️ 向量值本身不存这里，而放在版本专属的物理表 KnowledgeBaseEmbeddingVersion.vectorTable
//    （列固定 vector(dimensions)，建 HNSW 索引）。这张表只记录状态，用于进度统计与失败重试。
// ---------------------------------------------------------------------------

model DocumentChunkEmbedding {
  id                 String @id @default(uuid())
  chunkId            String
  embeddingVersionId String

  // PENDING 待生成 / DONE 已完成 / FAILED 失败
  status String  @default("PENDING")
  error  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunk   DocumentChunk                 @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  version KnowledgeBaseEmbeddingVersion @relation(fields: [embeddingVersionId], references: [id], onDelete: Cascade)

  @@unique([chunkId, embeddingVersionId])
  @@index([embeddingVersionId])
  @@index([embeddingVersionId, status])
}

// ---------------------------------------------------------------------------
// Agent —— 可配置的 AI Agent（绑定 Workflow / Knowledge / LLM Prompt）
// ---------------------------------------------------------------------------

model Agent {
  id                  String   @id @default(uuid())
  workspaceId         String?          // 可空：系统 Agent 不属于任何 Workspace
  createdBy           String?          // 可空：系统 Agent 无创建者

  name                String
  description         String?
  avatar              String?          // 头像或图标标识
  type                String   @default("GENERAL")  // GENERAL / KNOWLEDGE / WORKFLOW / TOOL / CUSTOM
  isDefault           Boolean  @default(false)      // 是否为用户的默认 Agent
  isSystem            Boolean  @default(false)      // 系统预设 Agent（不可删除）
  status              String   @default("PUBLISHED") // DRAFT / PUBLISHED / DISABLED

  // LLM 配置
  model               String   @default("qwen2.5:7b")
  /** 关联用户在「模型管理」中添加的自定义模型（优先于 model 字段）；为空则回退到 Ollama 本地 model */
  llmModelId          String?
  systemPrompt        String?  // System Prompt，支持 {{变量}}

  // 绑定的工具资源（JSON 存储 ID 数组，避免多对多中间表爆炸）
  workflowIds         String[]
  knowledgeBaseIds    String[]
  skillIds            String[]
  mcpServerIds        String[]

  // 运行参数
  maxToolIterations   Int      @default(10)   // ReAct 循环上限，防无限调用
  temperature         Float    @default(0.7)

  /** 是否允许 Agent 调用 generate_file 工具生成 Word / Excel / PDF / Markdown 文件 */
  enableFileGeneration Boolean @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace           Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  creator             User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  sessions            ChatSession[]
  /** 人格配置（仅系统默认助理有，见 AgentPersona） */
  persona             AgentPersona?

  @@index([workspaceId])
  @@index([createdBy])
  @@index([isSystem])
}

// ---------------------------------------------------------------------------
// AgentPersona —— 平台助理的「表达层」配置
//
// 为什么独立成表而不是塞进 Agent 的 JSON 字段：
//   AgentService.update() 对系统 Agent 只放开 llmModelId / model / temperature
//   三个字段（SYSTEM_AGENT_EDITABLE_FIELDS），任何其它字段一律 400。
//   人格如果存在 Agent 上，要么放开白名单（面过大），要么每次保存都被拒。
//
// 另外 personaVersion 让「改了人格 → 效果变差 → 回滚」成为可操作的事。
// ---------------------------------------------------------------------------

model AgentPersona {
  id      String @id @default(uuid())
  agentId String @unique

  /** 人格名字（默认「小蝶」）—— 只影响展示与语气，不改变系统标识 */
  name String @default("小蝶")
  tags String[] @default(["仿真", "真人感", "甜美", "粘人"])

  /** 人格提示词：只描述「怎么说」，不得覆盖平台职责与安全约束 */
  systemPrompt String
  avatar       String?

  voiceEnabled Boolean @default(true)
  /** Edge TTS 音色白名单内的 id（见 persona/persona.prompt.ts 的 VOICE_OPTIONS） */
  voiceId      String  @default("zh-CN-XiaoyiNeural")
  speechRate   Float   @default(1.0)
  pitch        Float   @default(1.0)

  desktopPetEnabled      Boolean @default(false)
  proactiveChatEnabled   Boolean @default(false)
  /** off / low / medium / high —— 客户端按档位限频，后端只存配置 */
  proactiveChatFrequency String  @default("low")

  screenPerceptionEnabled  Boolean @default(false)
  /** 截屏感知间隔（秒），最小 30 */
  screenPerceptionInterval Int     @default(60)

  /** 人格配置版本号，每次保存自增，便于审计与回滚 */
  personaVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// DesktopPetSettings —— 桌面桌宠的客户端偏好（按用户，不按 Agent）
// ---------------------------------------------------------------------------

model DesktopPetSettings {
  id     String @id @default(uuid())
  userId String @unique

  enabled                 Boolean @default(false)
  voiceEnabled            Boolean @default(true)
  proactiveChatEnabled    Boolean @default(false)
  screenPerceptionEnabled Boolean @default(false)
  perceptionInterval      Int     @default(60)
  autoLaunch              Boolean @default(false)

  positionX Int?
  positionY Int?
  scale     Float   @default(1.0)

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Memory —— 平台助理的对话记忆
//
// 与知识库的区别：知识库是「文档 → 分块 → 向量」的检索资产；
// 记忆是「对话 → 摘要 → 事实」的上下文资产，归属于单个用户。
//
// 向量为什么用 Float[] 而不是 pgvector：
//   用户随时可能更换 Embedding 模型，维度会变；pgvector 的 vector(N) 是固定维度列，
//   换模型就要重建列 + 索引。知识库为这一点已经付出「每版本一张物理向量表」的代价，
//   记忆不该再踩一遍。单用户记忆量级（几十~几千条）在应用层算余弦完全够用。
// ---------------------------------------------------------------------------

model Memory {
  id      String @id @default(uuid())
  userId  String
  agentId String

  /** PREFERENCE / FACT / TASK / EVENT / EMOTION / OTHER */
  category String @default("FACT")
  /** 简要描述（详情面板标题 + 悬停提示 + 召回注入 Prompt 的内容） */
  summary  String
  /** 原文（仅在详情面板按需加载） */
  content  String

  /** 重要度 0~1，映射 3D 节点亮度/大小 */
  importance Float @default(0.5)

  embedding      Float[]
  embeddingModel String?

  sourceConversationId String?
  sourceMessageId      String?

  lastAccessedAt DateTime?
  accessCount    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, agentId, createdAt])
  @@index([userId, category])
}

// ---------------------------------------------------------------------------
// MemoryLink —— 记忆间关联（供 3D 网络渲染连线，weight 决定线亮度）
// ---------------------------------------------------------------------------

model MemoryLink {
  id       String @id @default(uuid())
  userId   String
  sourceId String
  targetId String
  weight   Float  @default(1.0)

  @@unique([sourceId, targetId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// MemorySetting —— 记忆的生成 / 召回偏好（按用户）
// ---------------------------------------------------------------------------

model MemorySetting {
  id     String @id @default(uuid())
  userId String @unique

  /** 是否允许对话后自动沉淀记忆（默认开启，用户可关） */
  autoCaptureEnabled Boolean @default(true)
  /** 抽取记忆使用的模型（为空则用用户默认对话模型） */
  captureModelId     String?
  /** 召回注入对话的条数上限（默认 6，上限 10） */
  recallLimit        Int     @default(6)

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// RefreshToken —— 桌宠客户端的短时效凭证
//
// 网页端继续用 7 天长效 JWT（不动既有登录态）；桌宠必须用短 TTL access token，
// 靠 refresh token 轮换。存 hash 不存明文，使用一次即轮换（旧的立即吊销）。
// ---------------------------------------------------------------------------

model RefreshToken {
  id        String @id @default(uuid())
  userId    String
  /** sha256(refreshToken)，绝不明文存储 */
  tokenHash String @unique
  /** DESKTOP / WEB */
  scope     String @default("DESKTOP")

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// ChatSession —— 每个 Agent 拥有独立的会话列表
// ---------------------------------------------------------------------------

model ChatSession {
  id          String      @id @default(uuid())
  userId      String
  agentId     String

  title       String      @default("新对话")

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  files       GeneratedFile[]
  /** 本会话中用户上传的附件（聊天输入文件，与 AI 产出文件分开管理） */
  attachments ChatAttachment[]

  @@index([userId, agentId, updatedAt])
}

// ---------------------------------------------------------------------------
// ChatMessage —— 会话中的消息（用户 + Agent 回复 + 执行轨迹）
// ---------------------------------------------------------------------------

model ChatMessage {
  id          String      @id @default(uuid())
  sessionId   String

  role        String      // user / assistant / system / tool
  content     String

  /** Assistant 消息的 LLM 原始 tool_calls —— JSON 存储（用于多轮对话历史重建） */
  toolCalls   Json?
  /** Assistant 消息的执行轨迹（thinking / tool_call / tool_result）—— JSON 存储 */
  trail       Json?

  /** tool 消息关联的 tool_call_id */
  toolCallId  String?

  createdAt   DateTime    @default(now())

  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /** 本条消息关联的生成文件（Agent 通过 generate_file 工具产出） */
  files       GeneratedFile[]
  /** 本条消息携带的用户上传附件 */
  attachments ChatAttachment[]

  @@index([sessionId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// ChatAttachment —— 聊天输入附件（用户上传给 AI 的文件）
//
// 与 GeneratedFile（AI 产出文件）分开管理：
//   - 生命周期不同：附件随会话存在，可独立删除，不会自动进知识库、不参与向量化
//   - 处理状态不同：UPLOADED → PROCESSING → READY / FAILED（解析完成后才能对话）
//   - 用途不同：解析出的文本交给模型做上下文，而不是给用户下载
//
// 二进制同样不入库：落到 StorageService（本地磁盘 / 七牛云），库内只存 storageKey。
// ---------------------------------------------------------------------------

model ChatAttachment {
  id           String   @id @default(uuid())

  /** 归属用户（权限校验依据） */
  userId       String
  /** 所属会话（可选，上传时可能还没创建会话） */
  sessionId    String?
  /** 随哪条用户消息发送给模型（发送后回填） */
  messageId    String?

  originalName String
  mimeType     String
  extension    String
  size         Int      @default(0)
  storageKey   String   @unique

  /** 文件大类：PDF / DOCUMENT / SPREADSHEET / TEXT / IMAGE */
  kind         String   @default("TEXT")
  /** 处理状态：UPLOADED / PROCESSING / READY / FAILED */
  status       String   @default("UPLOADED")

  /** 解析出的纯文本（超长文档会截断，避免单条记录过大） */
  extractedText String?
  /** 解析文本字符数 */
  charCount    Int      @default(0)
  /** 结构化摘要（如 Excel 工作表 / 列统计信息） */
  summary      String?
  /** 失败原因（status = FAILED 时，可直接展示给用户） */
  parseError   String?
  /** 解析器附加元数据（页数 / 工作表数 / 图片尺寸等） */
  meta         Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session      ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  message      ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([messageId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// GeneratedFile —— 生成文件元数据（Word / Excel / PDF / Markdown / CSV）
//
// 文件二进制不入库：统一落到 StorageService（本地磁盘 / 七牛云），
// 数据库只保存元数据 + storageKey，预览与下载均经后端鉴权代理。
// ---------------------------------------------------------------------------

model GeneratedFile {
  id          String   @id @default(uuid())

  /** 归属用户（权限校验依据） */
  userId      String
  workspaceId String?
  /** 来源会话（可选） */
  sessionId   String?
  /** 来源消息（可选，文件卡片渲染到该条消息下方） */
  messageId   String?

  fileName    String
  mimeType    String
  extension   String
  /** 文件大小（字节） */
  size        Int      @default(0)
  /** 对象存储 Key（本地模式为绝对路径） */
  storageKey  String   @unique

  /** 生成格式：docx / xlsx / pdf / md / csv */
  format      String
  /** 来源：chat / agent / workflow / skill */
  sourceType  String   @default("chat")
  /** 状态：PROCESSING / READY / FAILED */
  status      String   @default("READY")
  /** 前端预览组件类型：pdf / image / document / spreadsheet / markdown / text / csv */
  previewType String?
  /** 错误原因（status = FAILED 时） */
  errorMessage String?

  title       String?
  summary     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  message     ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([messageId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Friendship（好友关系 —— 单向存储，列表查询用 OR 双向匹配）
// ---------------------------------------------------------------------------

model Friendship {
  id        String   @id @default(uuid())

  userId    String   // 发起者
  friendId  String   // 接收者

  status    String   @default("PENDING") // PENDING / ACCEPTED / REJECTED / BLOCKED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("FriendshipInitiator", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendshipReceiver", fields: [friendId], references: [id], onDelete: Cascade)

  // 同一对用户只能有一条 Friendship 记录
  @@unique([userId, friendId])
  @@index([friendId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Skill —— 可复用的 Agent 能力定义（Prompt / Workflow / Tool 三种类型）
// ---------------------------------------------------------------------------

model Skill {
  id          String   @id @default(uuid())
  ownerId     String

  name        String
  description String?

  // Skill 类型：PROMPT（指令模板）/ WORKFLOW（调用工作流）/ TOOL（调用 MCP）
  type        String   @default("PROMPT")

  // System Instructions（Prompt 类型的核心 —— 告诉 Agent 如何完成某类任务）
  instructions String?

  // 输入参数 schema（JSON Schema 格式，LLM 可见的 function parameters）
  inputSchema  Json?

  // 输出格式（Markdown / JSON / Text）
  outputFormat String   @default("Markdown")

  // WORKFLOW 类型：绑定的 Workflow ID
  workflowId   String?

  // TOOL 类型：绑定的 McpServer ID + Tool Name
  mcpServerId  String?
  mcpToolName  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner        User     @relation("SkillOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// McpServer —— MCP (Model Context Protocol) 外部能力连接
// ---------------------------------------------------------------------------

model McpServer {
  id          String   @id @default(uuid())
  ownerId     String

  name        String
  description String?

  // 传输方式：SSE / STREAMABLE_HTTP（远程） | STDIO（本地子进程）
  transport   String   @default("STREAMABLE_HTTP")

  // MCP Server URL —— 仅远程传输有值；STDIO 为 null
  serverUrl   String?

  // STDIO 专用：可执行文件 + 参数（等价于 Claude Desktop 的 command / args）
  command     String?
  args        Json?

  // STDIO 专用：额外环境变量（加密存储，形如 { v: 2, cipher }，可能含 API Key）
  envCipher   Json?

  // 认证方式：NONE / API_KEY / BEARER_TOKEN（仅远程传输使用）
  authType    String   @default("NONE")

  // 凭证（API Key / Bearer Token 值，生产环境应加密存储）
  credentials Json?

  // 连接状态：DISCONNECTED / CONNECTED / ERROR
  status      String   @default("DISCONNECTED")

  // 最近错误信息
  lastError   String?

  // 可用 Tools 列表（连接成功后缓存，JSON 数组）
  availableTools Json?

  // 协议协商结果（initialize 握手成功后写入）
  protocolVersion String?
  serverName      String?
  serverVersion   String?

  // 最后一次成功连接时间
  lastConnectedAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner        User     @relation("McpServerOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// PlatformOperationLog —— 平台助理操作审计
//
// 平台助理（默认 Chat Agent）通过内置平台工具创建 / 修改 / 执行平台资源时，
// 每次工具调用都会落一条记录，用于事后追溯与排查：
//   谁（userId）在哪个会话（sessionId）里、用哪个工具（tool）、
//   对哪个资源（targetType + targetId）、做了什么（action）、结果如何（status）。
//
// 只记录「已进入工具执行阶段」的调用；模型层被拒绝 / 未触发的调用不入库。
// 与 ChatMessage.trail 的区别：trail 属于会话上下文（会被模型看到），
// 本表是独立的审计账本（不参与对话，可按用户/资源/时间维度检索）。
// ---------------------------------------------------------------------------

model PlatformOperationLog {
  id            String   @id @default(uuid())

  /** 执行用户（来自后端已验证的 JWT 上下文，绝不信任模型传参） */
  userId        String
  /** 当前 Workspace（可空：跨空间或用户级操作） */
  workspaceId   String?
  /** 触发该操作的聊天会话 */
  sessionId     String?
  /** 触发该操作的 Agent（通常为平台助理） */
  agentId       String?

  /** 工具名，如 create_workflow_draft */
  tool          String
  /** 语义动作：QUERY / CREATE / UPDATE / DELETE / EXECUTE */
  action        String   @default("QUERY")
  /** 风险等级：LOW / MEDIUM / HIGH（产品授权策略，非技术限制） */
  riskLevel     String   @default("LOW")

  /** 目标资源类型：workflow / knowledge_base / document / agent / workspace / skill / mcp_server */
  targetType    String?
  targetId      String?
  targetName    String?

  /** 结果：SUCCESS / FAILED / DENIED */
  status        String   @default("SUCCESS")
  /** 人类可读的结果摘要（前端操作卡片直接展示） */
  summary       String?
  /** 前端可跳转的资源入口，如 /workspace/<workflowId> */
  link          String?

  /** 工具入参（已剥离敏感字段，超长会截断） */
  params        Json?
  errorMessage  String?
  durationMs    Int?

  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([tool])
  @@index([targetType, targetId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// LlmProviderConfig —— 用户自定义的模型提供商连接配置（云端 API / 本地 Ollama）
// ---------------------------------------------------------------------------

model LlmProviderConfig {
  id              String   @id @default(uuid())
  ownerId         String

  // 用户自定义名称，如「我的 DeepSeek」
  name            String

  // 提供商类型：ollama | openai | deepseek | openai-compatible
  provider        String

  // API 地址（openai-compatible / ollama 可自定义；云端厂商有默认值）
  baseUrl         String?

  // 加密后的 API Key（AES-256-GCM），绝不明文存储
  encryptedApiKey String?

  // 连接状态：UNKNOWN / CONNECTED / ERROR / DISABLED
  status          String   @default("UNKNOWN")

  // 最近一次连接测试的错误信息（不记录密钥）
  lastError       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User     @relation("LlmConfigOwner", fields: [ownerId], references: [id])
  models          LlmModel[]

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// KnowledgeBaseEmbeddingVersion —— 知识库的「向量版本」
//
// 一个知识库可以同时存在多个向量版本（不同模型 / 不同维度），
// 但只有 isActive = true 的那个参与检索。切换模型 = 建新版本 → 重新向量化 → 激活。
// ---------------------------------------------------------------------------

model KnowledgeBaseEmbeddingVersion {
  id              String @id @default(uuid())
  knowledgeBaseId String

  // 该版本使用的向量模型：本地 Ollama 模型名，或 LlmModel.modelId（云端/自定义）
  modelId         String
  llmModelId      String?

  // 该版本的向量维度（写入前逐条校验，保证整列同维）
  dimensions      Int

  // 该版本对应的物理向量表名（每个版本一张表，列固定为 vector(dimensions)，
  // 才能建 HNSW 索引 —— pgvector 不允许在无维度的 vector 列上建索引）
  vectorTable     String

  // PENDING 待处理 / PROCESSING 处理中 / READY 就绪 / FAILED 失败 / ARCHIVED 已归档（回滚后保留）
  status          String  @default("PENDING")
  isActive        Boolean @default(false)

  chunkTotal      Int     @default(0)
  chunkDone       Int     @default(0)
  chunkFailed     Int     @default(0)

  error       String?
  activatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  knowledgeBase KnowledgeBase            @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  embeddings    DocumentChunkEmbedding[]

  @@index([knowledgeBaseId])
  @@index([knowledgeBaseId, isActive])
}

// ---------------------------------------------------------------------------
// LlmModel —— 提供商下可选的模型（区分聊天 / Embedding 等能力）
// ---------------------------------------------------------------------------

model LlmModel {
  id           String   @id @default(uuid())
  configId     String

  // 冗余存储 provider，查询时无需连表
  provider     String

  // 真实模型 ID，如 deepseek-chat / gpt-4o-mini / nomic-embed-text
  modelId      String

  // 前端展示名称
  displayName  String?

  // 能力标签（多选）：
  //   CHAT 对话 / STREAM 流式 / TOOLS 工具调用 / EMBEDDING 向量化
  //   VISION 视觉理解 / REASONING 推理 / RERANK 重排序 / IMAGE_GENERATION 图片生成
  capabilities String[] @default(["CHAT", "STREAM"])

  // 输入模态：text / image / audio
  inputModalities  String[] @default(["text"])
  // 输出模态：text / image
  outputModalities String[] @default(["text"])

  // 仅向量模型有意义：实测输出维度（由「验证模型」写入，不靠模型名猜）
  embeddingDimensions Int?

  // 最大输入 token（按模型实际规格填写，可空）
  maxInputTokens Int?

  // 是否通过实测验证（连接 + 能力 + 维度）
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  // 是否为用户默认模型（同一 owner 仅一个）
  isDefault    Boolean  @default(false)

  // 是否允许在模型选择器中出现
  enabled      Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  config       LlmProviderConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, modelId])
  @@index([configId])
}
